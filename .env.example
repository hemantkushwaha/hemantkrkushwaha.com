# ==============================================================================
# Hemant Kumar Kushwaha Knowledge Platform - Environment Configuration
# ==============================================================================

# Application Base URL & Domain
VITE_SITE_URL="https://hemantkrkushwaha.com"
VITE_SITE_NAME="Hemant Kumar Kushwaha Knowledge Platform"

# Environment Mode
NODE_ENV="development"

# Port (Standard dev container default)
PORT=3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration (Step 3)
# ------------------------------------------------------------------------------
# CLIENT-SIDE (Public browser-safe variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER-SIDE ONLY (Secret administrative key - NEVER expose to browser)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Content Ingestion API Authentication (Step 10 - Server-Side Only)
# ------------------------------------------------------------------------------
# Secret token for authenticating POST /api/ingest/content requests.
# Must be passed as: Authorization: Bearer <CONTENT_INGESTION_API_KEY>
# NEVER prefix with VITE_ or expose to browser.
CONTENT_INGESTION_API_KEY=

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Do NOT populate until subsequent steps)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# GOOGLE_ADSENSE_CLIENT_ID=
