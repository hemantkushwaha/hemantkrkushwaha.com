# ==============================================================================
# Hemant Kumar Kushwaha Knowledge Platform - Environment Configuration
# ==============================================================================

# Application Base URL & Domain
VITE_SITE_URL="https://hemantkrkushwaha.com"
VITE_SITE_NAME="Hemant Kumar Kushwaha Knowledge Platform"

# Environment Mode
NODE_ENV="development"

# Port (Standard dev container default)
PORT=3000

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database Configuration (Step 3)
# ------------------------------------------------------------------------------
# CLIENT-SIDE (Public browser-safe variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SERVER-SIDE ONLY (Secret administrative key - NEVER expose to browser)
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Supabase Storage Configuration (Step 11 - Server-Side File Ingestion)
# ------------------------------------------------------------------------------
# Storage bucket name for content files (PDF, PPT, DOC, images, etc.). Defaults to 'content-files'.
SUPABASE_STORAGE_BUCKET="content-files"
# Configurable maximum file size in bytes. Defaults to 52428800 (50MB).
MAX_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# Content Ingestion API & Automation Gateway (Step 10 & 16 & 19 - Server-Side / Local CLI Only)
# ------------------------------------------------------------------------------
# Target gateway base URL for automation runners (e.g. scripts/notebookLM-ingest.ts).
# NEVER prefix with VITE_ or expose to browser.
CONTENT_INGESTION_BASE_URL="https://hemantkrkushwaha.com"

# Secret token for authenticating POST /api/ingest/content and POST /api/automation/ingest.
# Must be passed as: Authorization: Bearer <CONTENT_INGESTION_API_KEY>
# NEVER prefix with VITE_ or expose to browser. NEVER commit actual secret.
CONTENT_INGESTION_API_KEY=

# ------------------------------------------------------------------------------
# Google Drive API & OAuth 2.0 Configuration (Step 22 - Server-Side Only)
# ------------------------------------------------------------------------------
# Official Google OAuth 2.0 Client Credentials
# Sourced from Google Cloud Console > APIs & Services > Credentials
# NEVER prefix with VITE_ or expose to browser. Placeholders only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# 32-byte (or 64-character hex) key for AES-256-GCM token encryption
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Future Integration Placeholders (Do NOT populate until subsequent steps)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# GOOGLE_ADSENSE_CLIENT_ID=
